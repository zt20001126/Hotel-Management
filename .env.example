# MySQL application connection. URL user/password must use URL-safe characters or percent encoding.
DATABASE_URL=jdbc:mysql://mysql:3306/qianxun?user=qianxun&password=qianxun&useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia%2FShanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_ROOT_PASSWORD=qianxun

# Redis
REDIS_URL=redis://:replace_with_a_unique_password@redis:6379

# Spring Boot
JWT_SECRET=replace_with_at_least_32_random_characters

# WeChat Mini Program credentials (fill these before enabling WeChat login)
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_APP_SECRET=
