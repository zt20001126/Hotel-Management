<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.homestay.module.system.mapper.OperatingExpenseMapper">
    <sql id="filters">
        <where>
            <if test="keyword != null and keyword.trim() != ''">AND content LIKE CONCAT('%', REPLACE(REPLACE(REPLACE(#{keyword}, '\\', '\\\\'), '%', '\\%'), '_', '\\_'), '%')</if>
            <if test="startTime != null">AND created_at &gt;= #{startTime}</if>
            <if test="endTime != null">AND created_at &lt; #{endTime}</if>
        </where>
    </sql>
    <select id="selectExpensePage" resultType="com.homestay.module.system.vo.OperatingExpenseVO">
        SELECT id, content, amount, created_at, updated_at FROM operating_expenses
        <include refid="filters"/> ORDER BY created_at DESC, id DESC
    </select>
    <select id="statistics" resultType="com.homestay.module.system.vo.OperatingExpenseStatisticsVO">
        SELECT COALESCE(SUM(amount), 0) AS total_amount, COUNT(*) AS total_count FROM operating_expenses
        <include refid="filters"/>
    </select>
</mapper>
