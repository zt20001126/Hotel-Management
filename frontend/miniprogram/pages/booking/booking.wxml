<view class="booking-page">
  <view class="top-art" aria-hidden="true">
    <image class="plum-art" src="/assets/images/chinese-style/decorations/decoration-plum-branch.webp" mode="aspectFit" />
    <image class="houses-art" src="/assets/images/chinese-style/decorations/decoration-baijianlou-houses.webp" mode="aspectFit" />
  </view>
  <view class="content">
    <view class="room-card card">
      <image wx:if="{{roomImage}}" class="room-image" src="{{roomImage}}" mode="aspectFill" binderror="onRoomImageError" />
      <view wx:else class="room-image room-image-placeholder"><image src="../rooms/icon-bed.svg" mode="aspectFit" /></view>
      <view class="room-main">
        <view class="room-name">{{roomType.name}}</view>
        <view class="room-tags">
          <view class="tag" wx:if="{{roomType.bedType}}"><image src="../rooms/icon-bed.svg" />{{roomType.bedType}}</view>
          <view class="tag" wx:if="{{roomType.area}}"><image src="../rooms/icon-area.svg" />{{roomType.area}}㎡</view>
          <view class="tag" wx:if="{{roomType.maxGuests}}"><image src="../rooms/icon-guests.svg" />最多{{roomType.maxGuests}}人</view>
        </view>
      </view>
      <image class="room-cloud" src="/images/cloud.svg" mode="aspectFit" aria-hidden="true" />
    </view>
    <view class="date-card card">
      <view class="calendar-box"><image src="./icon-calendar.svg" /></view>
      <view class="date-rows">
        <picker mode="date" value="{{checkInDate}}" start="{{today}}" bindchange="onCheckInChange"><view class="date-row"><text>入住日期</text><view class="date-value">{{checkInDate}}<text class="chevron"></text></view></view></picker>
        <picker mode="date" value="{{checkOutDate}}" start="{{minCheckOut}}" bindchange="onCheckOutChange"><view class="date-row"><text>退房日期</text><view class="date-value">{{checkOutDate}}<text class="chevron"></text></view></view></picker>
      </view>
      <view class="nights"><view class="moon"></view><view class="nights-pill">共 {{nights}} 晚</view></view>
    </view>
    <view class="form-card card">
      <view class="section-title">入住信息</view>
      <view class="form-item"><image class="row-icon" src="./icon-user.svg" /><text class="field-name">入住人姓名</text><input class="input" placeholder="请输入姓名" placeholder-class="placeholder" value="{{form.guestName}}" bindinput="onInput" data-field="guestName" /></view>
      <view class="form-item"><image class="row-icon" src="./icon-phone.svg" /><text class="field-name">手机号码</text><input class="input" placeholder="请输入手机号" placeholder-class="placeholder" type="number" value="{{form.guestPhone}}" bindinput="onInput" data-field="guestPhone" /></view>
      <view class="form-item"><image class="row-icon" src="./icon-id.svg" /><text class="field-name">身份证号</text><input class="input" placeholder="请输入身份证号" placeholder-class="placeholder" value="{{form.guestIdCard}}" bindinput="onInput" data-field="guestIdCard" /></view>
      <view class="form-item"><image class="row-icon" src="./icon-guests.svg" /><text class="field-name">入住人数</text><picker class="guest-picker" mode="selector" range="{{guestOptions}}" value="{{guestIndex}}" bindchange="onGuestChange"><view class="picker-value">{{guestOptions[guestIndex]}} 人<text class="chevron"></text></view></picker></view>
      <view class="form-item"><image class="row-icon" src="./icon-note.svg" /><text class="field-name">备注 <text class="optional">（选填）</text></text><input class="input" placeholder="如有特殊需求，请填写" placeholder-class="placeholder" value="{{form.remark}}" bindinput="onInput" data-field="remark" /></view>
    </view>
    <view class="price-card card">
      <view class="section-title">费用明细</view>
      <view class="price-row"><view class="price-label"><image class="row-icon" src="../rooms/icon-bed.svg" /><text>房费（¥{{roomType.basePrice}} × {{nights}}晚）</text></view><text>¥{{totalPrice}}</text></view>
      <view class="price-row" wx:if="{{deposit > 0}}"><view class="price-label"><image class="row-icon" src="./icon-shield.svg" /><text>保证金（{{depositRate * 100}}%）</text></view><text>¥{{deposit}}</text></view>
      <view class="price-row total"><view class="price-label"><image class="row-icon" src="./icon-wallet.svg" /><text>应付总计</text></view><text class="total-price">¥{{grandTotal}}</text></view>
      <view class="price-row deposit-row" wx:if="{{deposit > 0}}"><view class="price-label"><image class="row-icon deposit-icon" src="./icon-shield.svg" /><text>本次需支付保证金</text></view><text class="deposit-price">¥{{deposit}}</text></view>
    </view>
    <image class="bridge-art" src="/assets/images/chinese-style/decorations/decoration-stone-bridge-water.webp" mode="aspectFit" aria-hidden="true" />
  </view>
  <view class="bottom-bar"><view class="price-info"><text class="bottom-label">{{deposit > 0 ? '需付保证金' : '应付房费'}}</text><text class="amount">¥{{deposit > 0 ? deposit : totalPrice}}</text></view><button class="btn-submit" bindtap="submitOrder" loading="{{submitting}}" disabled="{{submitting}}">提交订单 <text class="button-arrow">›</text></button></view>
</view>
