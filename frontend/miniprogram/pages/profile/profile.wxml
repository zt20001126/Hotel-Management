<view class="container">
  <image class="profile-top-art" src="/assets/images/chinese-style/profile/profile-paper-plum.webp" mode="aspectFill"></image>
  <image class="profile-bottom-art" src="/assets/images/chinese-style/profile/profile-river-houses.webp" mode="aspectFill"></image>
  <view class="user-card card" wx:if="{{isLogin}}">
    <image class="user-town-art" src="/assets/images/chinese-style/profile/profile-ink-baijianlou.webp" mode="aspectFill"></image>
    <image class="user-mountain-art" src="/assets/images/chinese-style/decorations/decoration-gold-landscape.webp" mode="aspectFit"></image>
    <view class="avatar-wrap">
      <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
    </view>
    <view class="user-info">
      <view class="nickname">{{userInfo.nickname || '微信用户'}}</view>
      <view class="phone">{{userInfo.phone || '未绑定手机'}}</view>
    </view>
  </view>
  
  <view class="login-card card" wx:else>
    <text class="login-tip">登录后享受更多服务</text>
    <button class="btn-login btn-primary" bindtap="goLogin">立即登录</button>
  </view>
  
  <view class="menu-card card">
    <image class="menu-corner menu-tl" src="/images/keyfret.svg" mode="aspectFit"></image>
    <image class="menu-corner menu-tr" src="/images/keyfret.svg" mode="aspectFit"></image>
    <image class="menu-corner menu-bl" src="/images/keyfret.svg" mode="aspectFit"></image>
    <image class="menu-corner menu-br" src="/images/keyfret.svg" mode="aspectFit"></image>
    <view class="menu-item" wx:if="{{isEmployee}}" bindtap="goWorkbench">
      <image class="menu-icon" src="/images/profile-icon-orders.svg" mode="aspectFit"></image>
      <text class="menu-text">工作台</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{!isEmployee}}" bindtap="goOrders">
      <image class="menu-icon" src="/images/profile-icon-orders.svg" mode="aspectFit"></image>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{isLogin}}" bindtap="goEditProfile">
      <image class="menu-icon" src="/images/profile-icon-user.svg" mode="aspectFit"></image>
      <text class="menu-text">个人信息</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goContact">
      <image class="menu-icon" src="/images/profile-icon-service.svg" mode="aspectFit"></image>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <image class="menu-icon" src="/images/profile-icon-about.svg" mode="aspectFit"></image>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
  
  <button class="btn-logout" wx:if="{{isLogin}}" bindtap="logout">退出登录</button>
</view>
