.container { position:relative; min-height:calc(100vh - 100rpx); padding-top:22rpx; padding-bottom:210rpx; overflow:hidden; background:transparent; }
.profile-top-art { position:fixed; z-index:0; top:0; left:0; width:100%; height:430rpx; opacity:.98; pointer-events:none; }
.profile-bottom-art { position:fixed; z-index:0; left:0; bottom:calc(100rpx + env(safe-area-inset-bottom)); width:100%; height:600rpx; opacity:.9; pointer-events:none; }
.user-card { position:relative; z-index:1; display:flex; align-items:center; min-height:210rpx; box-sizing:border-box; padding:30rpx 34rpx; overflow:hidden; background:linear-gradient(115deg,#b23d2d,#8f281f); border:1rpx solid #ca9665; border-radius:24rpx; color:#fff8ed; box-shadow:0 10rpx 24rpx rgba(99,45,31,.18); }
.avatar-wrap { position:relative; z-index:2; flex:none; }
.avatar-wrap .avatar { display:block; width:132rpx; height:132rpx; border:4rpx solid rgba(255,246,226,.9); border-radius:50%; background:#f4e4c9; }
.user-info { position:relative; z-index:2; min-width:0; margin-left:26rpx; }
.nickname { max-width:440rpx; overflow:hidden; margin-bottom:12rpx; color:#fffaf0; font-size:36rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
.phone { color:rgba(255,248,237,.9); font-size:26rpx; }
.user-mountain-art { position:absolute; z-index:1; right:-20rpx; bottom:-24rpx; width:390rpx; height:220rpx; opacity:.32; pointer-events:none; }
.login-card { position:relative; z-index:1; padding:44rpx 32rpx; text-align:center; }
.login-tip { display:block; margin-bottom:22rpx; color:#897966; }
.btn-login { width:300rpx; height:76rpx; margin:auto; }
.menu-card { position:relative; z-index:1; padding:10rpx 30rpx; margin-top:24rpx; overflow:hidden; background:rgba(255,249,239,.96); border:1rpx solid #d6b987; border-radius:22rpx; box-shadow:0 8rpx 22rpx rgba(91,63,35,.1); }
.menu-item { position:relative; z-index:2; display:flex; align-items:center; min-height:104rpx; padding:0 12rpx; border-bottom:1rpx solid #ead9bd; }
.menu-item:last-child { border-bottom:0; }
.menu-icon { display:block; flex:none; width:52rpx; height:52rpx; margin-right:26rpx; }
.menu-text { flex:1; color:#30271f; font-family:"STKaiti","KaiTi",serif; font-size:32rpx; font-weight:600; }
.menu-arrow { color:#b99462; font-family:serif; font-size:48rpx; line-height:1; }
.menu-corner { position:absolute; z-index:3; width:48rpx; height:48rpx; pointer-events:none; opacity:.78; }
.menu-tl { top:0; left:0; }
.menu-tr { top:0; right:0; transform:scaleX(-1); }
.menu-bl { bottom:0; left:0; transform:scaleY(-1); }
.menu-br { bottom:0; right:0; transform:scale(-1); }
.btn-logout { position:relative; z-index:1; width:68%; height:88rpx; margin:52rpx auto 0; background:rgba(255,249,239,.82); border:3rpx double #a83e2a; border-radius:999rpx; color:#a83e2a; font-family:"STKaiti","KaiTi",serif; font-size:32rpx; font-weight:700; letter-spacing:4rpx; box-shadow:inset 0 0 0 5rpx rgba(168,62,42,.1); }
.btn-logout:active { opacity:.78; background:#f3e5d2; }
