.user-card { position: relative; display: flex; align-items: center; padding: 36rpx; overflow: hidden; background: linear-gradient(130deg, #a94a35, #7e2c22); border-color: #c28b61; color: #fff9ef; }
.user-card::after { content: "⌁  山  ⌁"; position: absolute; right: 24rpx; bottom: 8rpx; color: rgba(255, 226, 192, .22); font-family: "STKaiti", "KaiTi", serif; font-size: 54rpx; }
.avatar-wrap .avatar { width: 118rpx; height: 118rpx; border: 4rpx solid rgba(255,249,239,.7); border-radius: 50%; background: #e8d6bb; }
.user-info { margin-left: 26rpx; }
.nickname { margin-bottom: 10rpx; font-size: 34rpx; font-weight: 600; }
.phone { color: rgba(255,249,239,.82); font-size: 25rpx; }
.login-card { padding: 48rpx; text-align: center; }
.login-tip { display: block; margin-bottom: 22rpx; color: #978a7a; }
.btn-login { width: 300rpx; height: 76rpx; margin: auto; }
.menu-card { padding: 0 24rpx; margin-top: 24rpx; }
.menu-item { display: flex; align-items: center; padding: 27rpx 8rpx; border-bottom: 1rpx solid #eadcc7; }
.menu-item:last-child { border-bottom: 0; }
.menu-icon { width: 48rpx; margin-right: 16rpx; color: #a85435; font-size: 32rpx; text-align: center; }
.menu-text { flex: 1; color: #30271f; font-size: 29rpx; }
.menu-arrow { color: #b99462; font-size: 32rpx; }
.btn-logout { width: 68%; height: 78rpx; margin: 54rpx auto 0; background: #fff9ef; border: 2rpx solid #b85b43; border-radius: 999rpx; color: #a83e2a; font-size: 30rpx; }
.btn-logout:active { background: #f3e5d2; }

/* Reserve space for the custom four-item navigation bar. */
.container { padding-bottom: 150rpx; }
