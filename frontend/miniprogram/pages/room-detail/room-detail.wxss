page { min-height:100%; background:#f8eee1; color:#30271f; }
.container { position:relative; box-sizing:border-box; min-height:100vh; padding:0 28rpx calc(160rpx + env(safe-area-inset-bottom)); overflow:hidden; }
.top-decoration { position:relative; height:96rpx; pointer-events:none; }
.plum-art { position:absolute; left:-28rpx; top:0; width:280rpx; height:100rpx; opacity:.7; }
.houses-art { position:absolute; right:-28rpx; bottom:0; width:300rpx; height:90rpx; opacity:.25; }
.gallery { position:relative; overflow:hidden; border-radius:24rpx; }
.image-swiper { width:100%; height:350rpx; }
.room-image { display:block; width:100%; height:100%; }
.image-count { position:absolute; right:16rpx; bottom:14rpx; padding:5rpx 15rpx; border-radius:999rpx; background:rgba(40,30,20,.55); color:#fff; font-size:22rpx; }
.image-dots { display:flex; justify-content:center; align-items:center; gap:10rpx; height:36rpx; }
.image-dot { width:12rpx; height:9rpx; border-radius:999rpx; background:#dfcdbb; }
.image-dot.active { width:17rpx; background:#a83e2a; }
.info-card { position:relative; padding:8rpx 10rpx 10rpx; }
.info-cloud { position:absolute; right:0; top:2rpx; width:150rpx; height:65rpx; opacity:.45; pointer-events:none; }
.room-name { position:relative; color:#30271f; font-size:36rpx; font-weight:700; overflow-wrap:anywhere; padding-right:60rpx; }
.room-price { margin:12rpx 0 18rpx; }
.room-price .price { color:#a83e2a; font-size:48rpx; font-weight:700; }
.room-price .unit { color:#655548; font-size:25rpx; }
.room-tags { display:flex; flex-wrap:wrap; gap:10rpx; }
.tag { display:inline-flex; align-items:center; box-sizing:border-box; max-width:100%; padding:12rpx 14rpx; border-radius:16rpx; background:#f2e3d0; color:#514236; font-size:22rpx; overflow-wrap:anywhere; }
.tag-icon { flex:none; width:29rpx; height:29rpx; margin-right:8rpx; }
.detail-card { position:relative; margin-top:22rpx; padding:24rpx 28rpx; border:0; border-radius:24rpx; background:#fff8ef; box-shadow:0 5rpx 18rpx rgba(91,63,35,.1); }
.section-title { position:relative; display:flex; align-items:center; margin-bottom:18rpx; color:#30271f; font-size:30rpx; font-weight:700; }
.section-title::before { content:""; width:8rpx; height:32rpx; margin-right:18rpx; background:#a83e2a; border-radius:8rpx; }
.description { position:relative; padding-left:26rpx; color:#51463d; font-size:25rpx; line-height:1.75; }
.leaf-art { position:absolute; right:18rpx; top:6rpx; width:90rpx; height:80rpx; opacity:.16; }
.facilities { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); row-gap:22rpx; }
.facility { display:flex; flex-direction:column; align-items:center; min-width:0; padding:4rpx; color:#514236; font-size:22rpx; text-align:center; overflow-wrap:anywhere; }
.facility-icon { width:42rpx; height:42rpx; margin-bottom:8rpx; }
.bridge-ornament { display:block; width:100%; height:75rpx; margin-top:8rpx; opacity:.22; pointer-events:none; }
.bottom-bar { position:fixed; z-index:100; left:0; right:0; bottom:0; display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding:18rpx 36rpx calc(18rpx + env(safe-area-inset-bottom)); background:#fff9f1; box-shadow:0 -4rpx 20rpx rgba(91,63,35,.09); }
.price-info { min-width:0; display:flex; align-items:baseline; flex-wrap:wrap; }
.total-price { color:#a83e2a; font-size:40rpx; font-weight:700; overflow-wrap:anywhere; }
.bottom-unit { color:#978a7a; font-size:23rpx; white-space:nowrap; }
.btn-book { flex:none; width:46%; min-width:230rpx; height:72rpx; margin:0; border-radius:999rpx; background:#a83e2a; font-size:30rpx; }
.book-arrow { margin-left:16rpx; font-size:40rpx; line-height:1; }
