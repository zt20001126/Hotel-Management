<view class="container" wx:if="{{roomType}}">
  <view class="top-decoration" aria-hidden="true">
    <image class="plum-art" src="/assets/images/chinese-style/decorations/decoration-plum-branch.webp" mode="aspectFit"></image>
    <image class="houses-art" src="/assets/images/chinese-style/decorations/decoration-baijianlou-houses.webp" mode="aspectFit"></image>
  </view>
  <view class="gallery" wx:if="{{roomType.images.length}}">
    <swiper class="image-swiper" current="{{currentImage}}" bindchange="onSwiperChange" circular="{{roomType.images.length > 1}}">
      <swiper-item wx:for="{{roomType.images}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" class="room-image" lazy-load="{{true}}" binderror="onImageError" data-index="{{index}}"></image>
      </swiper-item>
    </swiper>
    <view class="image-count">{{currentImage + 1}} / {{roomType.images.length}}</view>
  </view>
  <view class="image-dots" wx:if="{{roomType.images.length > 1}}">
    <view wx:for="{{roomType.images}}" wx:key="index" class="image-dot {{index === currentImage ? 'active' : ''}}"></view>
  </view>
  <view class="info-card">
    <image class="info-cloud" src="/images/cloud.svg" mode="aspectFit" aria-hidden="true"></image>
    <view class="room-name">{{roomType.name}}</view>
    <view class="room-price"><text class="price">¥{{roomType.basePrice}}</text><text class="unit"> /晚</text></view>
    <view class="room-tags">
      <view class="tag"><image class="tag-icon" src="../rooms/icon-bed.svg" mode="aspectFit"></image><text>{{roomType.bedType}}</text></view>
      <view class="tag"><image class="tag-icon" src="../rooms/icon-area.svg" mode="aspectFit"></image><text>{{roomType.area}}㎡</text></view>
      <view class="tag"><image class="tag-icon" src="../rooms/icon-guests.svg" mode="aspectFit"></image><text>最多{{roomType.maxGuests}}人</text></view>
      <view class="tag"><image class="tag-icon" src="./icons/bed.svg" mode="aspectFit"></image><text>{{roomType.bedCount}}张床</text></view>
    </view>
  </view>
  <view class="detail-card card description-card">
    <image class="leaf-art" src="./icons/bamboo.svg" mode="aspectFit" aria-hidden="true"></image>
    <view class="section-title">房间描述</view>
    <view class="description">{{roomType.description || '暂无描述'}}</view>
  </view>
  <view class="detail-card card">
    <view class="section-title">设施服务</view>
    <view class="facilities">
      <view class="facility" wx:for="{{facilities}}" wx:key="index"><image class="facility-icon" src="{{item.icon}}" mode="aspectFit"></image><text>{{item.name}}</text></view>
    </view>
  </view>
  <image class="bridge-ornament" src="/assets/images/chinese-style/decorations/decoration-stone-bridge-water.webp" mode="aspectFit" aria-hidden="true"></image>
  <view class="bottom-bar">
    <view class="price-info"><text class="total-price">¥{{nightlyPrice}}</text><text class="bottom-unit"> /晚</text></view>
    <button class="btn-book btn-primary" bindtap="goBooking">立即预订<text class="book-arrow">›</text></button>
  </view>
</view>
