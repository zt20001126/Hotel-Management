page {
  background: #faf0e6;
}

.contact-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: #faf0e6;
}

.top-plum, .top-houses, .landscape, .landscape-houses, .landscape-bridge {
  position: absolute;
  pointer-events: none;
}

.top-plum {
  top: 0;
  left: -32rpx;
  width: 325rpx;
  height: 150rpx;
  opacity: .64;
}

.top-houses {
  top: 12rpx;
  right: -36rpx;
  width: 360rpx;
  height: 120rpx;
  opacity: .24;
}

.landscape {
  left: 0;
  right: 0;
  bottom: 30rpx;
  height: 270rpx;
  opacity: .17;
}

.landscape-houses {
  left: -50rpx;
  bottom: 0;
  width: 520rpx;
  height: 225rpx;
}

.landscape-bridge {
  right: -35rpx;
  bottom: 0;
  width: 370rpx;
  height: 180rpx;
}

.content {
  position: relative;
  z-index: 1;
  padding: 0 30rpx 330rpx;
}

.intro {
  padding: 112rpx 0 42rpx;
  text-align: center;
}

.intro-title, .intro-subtitle {
  display: block;
}

.intro-title {
  color: #4d250f;
  font-family: "Songti SC", "STSong", serif;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.3;
}

.intro-subtitle {
  margin-top: 12rpx;
  color: #75401f;
  font-size: 26rpx;
  line-height: 1.5;
}

.ornament {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
}

.ornament-line {
  width: 112rpx;
  height: 2rpx;
}
.ornament-line-left { background: linear-gradient(to right, transparent, #bd8055); }
.ornament-line-right { background: linear-gradient(to left, transparent, #bd8055); }
.ornament-icon { width: 34rpx; height: 34rpx; margin: 0 12rpx; }

.contact-panel {
  box-sizing: border-box;
  margin-bottom: 26rpx;
  padding: 25rpx 30rpx 30rpx;
  background: rgba(255, 249, 242, .84);
  border: 1rpx solid #f0d6c1;
  border-radius: 28rpx;
  box-shadow: 0 7rpx 20rpx rgba(151, 93, 49, .06);
}

.panel-title {
  display: flex;
  align-items: center;
  color: #4d250f;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}
.panel-title::before {
  content: "";
  width: 8rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  background: #ad2d18;
}
.panel-body {
  display: flex;
  align-items: center;
  margin-top: 27rpx;
}
.icon-box {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 20rpx;
  background: #fae3db;
}
.contact-icon { width: 40rpx; height: 40rpx; }
.panel-value {
  min-width: 0;
  margin-left: 24rpx;
  padding-left: 24rpx;
  border-left: 1rpx solid #e8ccba;
}
.phone-values {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: #a82916;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 1rpx;
}
.address-value {
  color: #27211d;
  font-size: 28rpx;
  line-height: 1.55;
  overflow-wrap: break-word;
}
