<view class="contact-page">
  <image class="top-plum" src="/assets/images/chinese-style/decorations/decoration-plum-branch.webp" mode="aspectFit" aria-hidden="true" />
  <image class="top-houses" src="/assets/images/chinese-style/decorations/decoration-baijianlou-houses.webp" mode="aspectFit" aria-hidden="true" />
  <view class="landscape" aria-hidden="true">
    <image class="landscape-houses" src="/assets/images/chinese-style/decorations/decoration-baijianlou-houses.webp" mode="aspectFit" />
    <image class="landscape-bridge" src="/assets/images/chinese-style/decorations/decoration-stone-bridge-water.webp" mode="aspectFit" />
  </view>

  <view class="content">
    <view class="intro">
      <text class="intro-title">联系我们</text>
      <text class="intro-subtitle">欢迎随时与我们联系，我们竭诚为您服务</text>
      <view class="ornament" aria-hidden="true">
        <view class="ornament-line ornament-line-left" />
        <image class="ornament-icon" src="./ornament.svg" />
        <view class="ornament-line ornament-line-right" />
      </view>
    </view>

    <view class="contact-panel phone-panel">
      <view class="panel-title">联系电话</view>
      <view class="panel-body">
        <view class="icon-box"><image class="contact-icon" src="./phone.svg" /></view>
        <view class="panel-value phone-values">
          <text>18557531002</text>
          <text>13867282089</text>
        </view>
      </view>
    </view>

    <view class="contact-panel address-panel">
      <view class="panel-title">民宿地址</view>
      <view class="panel-body">
        <view class="icon-box"><image class="contact-icon" src="./location.svg" /></view>
        <view class="panel-value address-value">浙江湖州南浔区宝善街167号</view>
      </view>
    </view>
  </view>
</view>
