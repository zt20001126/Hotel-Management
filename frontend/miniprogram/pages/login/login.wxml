<view class="container">
  <view class="logo-wrap">
    <image class="logo" src="/images/logo.png" mode="aspectFit" binderror="onLogoError" wx:if="{{showLogo}}"></image>
    <text class="app-name">悦居民宿</text>
  </view>
  
  <view class="form-card card">
    <!-- 登录类型选择 -->
    <view class="login-type-tabs">
      <view class="tab-item {{loginType === 'guest' ? 'active' : ''}}" 
            data-type="guest" 
            bindtap="switchLoginType">
        客户登录
      </view>
      <view class="tab-item {{loginType === 'employee' ? 'active' : ''}}" 
            data-type="employee" 
            bindtap="switchLoginType">
        员工登录
      </view>
    </view>
    
    <block wx:if="{{loginType === 'guest'}}">
      <view class="form-item login-tip">使用微信绑定手机号快捷登录</view>
      <button class="btn-login btn-primary"
              open-type="getPhoneNumber"
              bindgetphonenumber="onGetPhoneNumber"
              loading="{{loading}}"
              disabled="{{loading}}">
        微信手机号快捷登录
      </button>
    </block>
    <block wx:else>
      <view class="form-item">
        <input class="input" placeholder="请输入员工用户名" value="{{username}}" bindinput="onUsernameInput" />
      </view>
      <view class="form-item">
        <input class="input" placeholder="请输入密码" password value="{{password}}" bindinput="onPasswordInput" />
      </view>
      <button class="btn-login btn-primary" bindtap="login" loading="{{loading}}">员 工 登 录</button>
    </block>
  </view>
</view>
