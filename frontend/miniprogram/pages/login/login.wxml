<view class="login-page">
  <image
    class="login-background"
    src="/assets/images/chinese-style/backgrounds/background-bottom-water-town.webp"
    mode="aspectFill"
    aria-hidden="true"
  ></image>

  <view class="login-content">
    <view class="brand-block">
      <view class="brand-emblem">
        <image
          wx:if="{{showLogo}}"
          class="brand-logo"
          src="/images/logo-qianxun.jpg"
          mode="aspectFill"
          binderror="onLogoError"
          aria-label="芊浔民宿 Logo"
        ></image>
        <text wx:else class="brand-logo-fallback">芊</text>
      </view>

      <view class="brand-name-row">
        <view class="brand-rule"><view class="brand-dot"></view></view>
        <text class="brand-name">芊浔民宿</text>
        <view class="brand-rule brand-rule-right"><view class="brand-dot"></view></view>
      </view>
    </view>

    <view class="login-card">
      <image class="card-bamboo" src="/pages/login/bamboo.svg" mode="aspectFit" aria-hidden="true"></image>
      <image class="card-cloud" src="/images/cloud.svg" mode="aspectFit" aria-hidden="true"></image>
      <button
        class="quick-login-button"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        <view class="quick-login-content">
          <view class="wechat-mark" aria-hidden="true">
            <view class="wechat-bubble wechat-bubble-main"></view>
            <view class="wechat-bubble wechat-bubble-small"></view>
          </view>
          <text class="quick-login-label">微信手机号快捷登录</text>
          <text class="quick-login-arrow">›</text>
        </view>
      </button>
    </view>
  </view>
</view>
