.login-page {
  position: relative;
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 48rpx calc(56rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #f8f1e5;
}

.login-background {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
}

.login-content {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-top: 13vh;
}

.brand-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-emblem {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 264rpx;
  height: 264rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 10rpx 28rpx rgba(67, 58, 44, 0.12);
}

.brand-logo {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.brand-logo-fallback {
  color: #176d78;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 104rpx;
  font-weight: 700;
}

.brand-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 20rpx;
}

.brand-name {
  flex: none;
  margin: 0 24rpx;
  color: #176d78;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  line-height: 1.3;
  text-shadow: 0 2rpx 8rpx rgba(255, 250, 242, 0.7);
}

.brand-rule {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 24rpx;
  height: 2rpx;
  background: rgba(177, 153, 119, 0.62);
}

.brand-dot {
  width: 10rpx;
  height: 10rpx;
  margin-left: auto;
  border-radius: 50%;
  background: #c0ad91;
}

.brand-rule-right .brand-dot {
  margin-right: auto;
  margin-left: 0;
}

.login-card {
  position: relative;
  overflow: hidden;
  width: 100%;
  margin-top: 76rpx;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 44rpx;
  background: rgba(255, 249, 239, 0.88);
  box-shadow: 0 14rpx 36rpx rgba(75, 56, 35, 0.1);
}

.card-bamboo, .card-cloud {
  position: absolute;
  pointer-events: none;
}

.card-bamboo {
  top: 0;
  left: 0;
  width: 128rpx;
  height: 96rpx;
  opacity: 0.58;
}

.card-cloud {
  top: 12rpx;
  right: 10rpx;
  width: 125rpx;
  height: 52rpx;
  opacity: 0.28;
}

.quick-login-button {
  position: relative;
  display: block;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 108rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(105deg, #3d9991 0%, #287a79 100%);
  box-shadow: 0 10rpx 20rpx rgba(39, 111, 104, 0.2);
  font-size: 32rpx;
  font-weight: 600;
}

.quick-login-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  white-space: nowrap;
}

.quick-login-button::after {
  border: 0;
}

.wechat-mark {
  position: absolute;
  top: 50%;
  left: 34rpx;
  width: 56rpx;
  height: 46rpx;
  transform: translateY(-50%);
}

.wechat-bubble {
  position: absolute;
  width: 40rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #fffaf3;
}

.wechat-bubble::before {
  position: absolute;
  bottom: -4rpx;
  left: 7rpx;
  width: 0;
  height: 0;
  border-top: 7rpx solid #fffaf3;
  border-right: 5rpx solid transparent;
  content: "";
  transform: rotate(12deg);
}

.wechat-bubble::after {
  position: absolute;
  top: 8rpx;
  left: 9rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #3d9991;
  box-shadow: 12rpx 0 #3d9991;
  content: "";
}

.wechat-bubble-main {
  top: 0;
  left: 0;
}

.wechat-bubble-small {
  right: 0;
  bottom: 0;
  transform: scale(0.76);
  transform-origin: right bottom;
}

.quick-login-label {
  display: block;
  width: 100%;
  padding: 0 90rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
}

.quick-login-arrow {
  position: absolute;
  top: 50%;
  right: 34rpx;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
  transform: translateY(-50%);
}

@media screen and (max-height: 700px) {
  .login-content {
    margin-top: 7vh;
  }

  .brand-emblem {
    width: 224rpx;
    height: 224rpx;
  }

  .login-card {
    margin-top: 48rpx;
    padding-top: 48rpx;
    padding-bottom: 48rpx;
  }
}
