.search-card { padding: 32rpx; position: relative; overflow: hidden; border-color: #c9a878; }
.search-card::after { content: "⌁  ❀  ⌁"; position: absolute; right: 20rpx; bottom: 12rpx; color: #c9a878; opacity: .5; font-size: 28rpx; }
.search-title, .section-title { font-family: "STKaiti", "KaiTi", serif; font-size: 38rpx; font-weight: 700; color: #392c20; }
.search-title { margin-bottom: 16rpx; }
.form-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 4rpx; border-bottom: 1rpx solid #eadcc7; }
.form-item .label { color: #655548; font-size: 28rpx; }
.form-item .label::before { content: "▦"; color: #a45b32; margin-right: 16rpx; }
.form-item .picker { color: #30271f; font-size: 28rpx; }
.btn-search { margin: 26rpx auto 0; width: 72%; height: 84rpx; }
.section { margin-top: 34rpx; }
.section-title { margin: 0 0 20rpx 6rpx; }
.room-card { padding: 0; overflow: hidden; margin-bottom: 24rpx; }
.room-image { display: block; width: 100%; height: 300rpx; background: #e9dcc9; }
.room-info { padding: 22rpx 24rpx 26rpx; }
.room-name { font-size: 32rpx; font-weight: 600; margin-bottom: 10rpx; }
.room-desc { font-size: 24rpx; color: #978a7a; margin-bottom: 12rpx; }
.room-price .price { color: #a83e2a; font-size: 36rpx; font-weight: 700; }
.room-price .unit { color: #978a7a; font-size: 24rpx; }
