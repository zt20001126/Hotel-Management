<view class="container">
  <swiper class="home-art-swiper" autoplay="{{true}}" interval="7000" duration="1000" circular="{{true}}" indicator-dots="{{false}}" aria-hidden="true">
    <swiper-item><image class="home-art-image" src="/assets/images/chinese-style/home/home-ink-water-town.webp" mode="aspectFill"></image></swiper-item>
    <swiper-item><image class="home-art-image" src="/assets/images/chinese-style/home/home-plum-water-town.webp" mode="aspectFill"></image></swiper-item>
    <swiper-item><image class="home-art-image" src="/assets/images/chinese-style/home/home-golden-sunrise.webp" mode="aspectFill"></image></swiper-item>
    <swiper-item><image class="home-art-image" src="/assets/images/chinese-style/home/home-night-town.webp" mode="aspectFill"></image></swiper-item>
  </swiper>
  <view class="page-content">
  <view class="brand-title">芊浔民宿<text class="brand-seal">民宿</text></view>
  <!-- 搜索区域 -->
  <view class="search-card card">
    <image class="corner corner-tl" src="/images/keyfret.svg" mode="aspectFit"></image><image class="corner corner-tr" src="/images/keyfret.svg" mode="aspectFit"></image>
    <view class="search-title">预订房间</view>
    <view class="search-form">
      <view class="date-row">
        <picker mode="date" value="{{checkInDate}}" start="{{today}}" bindchange="onCheckInChange">
          <view class="date-card">
            <view class="date-heading"><text class="calendar-icon">▦</text><text>入住日期</text><text class="date-arrow">›</text></view>
            <text class="date-value">{{checkInDate || '请选择'}}</text>
          </view>
        </picker>
        <text class="date-connector">—</text>
        <picker mode="date" value="{{checkOutDate}}" start="{{minCheckOut}}" bindchange="onCheckOutChange">
          <view class="date-card">
            <view class="date-heading"><text class="calendar-icon">▦</text><text>退房日期</text><text class="date-arrow">›</text></view>
            <text class="date-value">{{checkOutDate || '请选择'}}</text>
          </view>
        </picker>
      </view>
      <view class="nights-wrap"><image class="night-ornament night-left" src="/images/cloud.svg" mode="aspectFit"></image><text class="night-pill">共 <text class="night-count">{{stayNights}}</text> 晚</text><image class="night-ornament night-right" src="/images/cloud.svg" mode="aspectFit"></image></view>
      <button class="btn-search btn-primary" bindtap="searchRooms">查询</button>
    </view>
    <image class="cloud-ornament cloud-card-left" src="/images/cloud.svg" mode="aspectFit"></image><image class="cloud-ornament cloud-card-right" src="/images/cloud.svg" mode="aspectFit"></image>
    <image class="corner corner-bl" src="/images/keyfret.svg" mode="aspectFit"></image><image class="corner corner-br" src="/images/keyfret.svg" mode="aspectFit"></image>
  </view>

  </view>
</view>
