.order-card { position: relative; padding: 26rpx; margin-bottom: 22rpx; }
.order-header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 20rpx; margin-bottom: 12rpx; border-bottom: 1rpx solid #eadcc7; }
.order-no { color: #655548; font-size: 25rpx; }
.status { padding: 7rpx 18rpx; border-radius: 999rpx; font-size: 23rpx; }
.status.pending { background: #f5e8cb; color: #987442; }
.status.confirmed { background: #e5eee4; color: #55715b; }
.status.checked_in { background: #e5eee4; color: #55715b; }
.status.checked_out { background: #eee9df; color: #786d60; }
.status.cancelled { background: #eeeae4; color: #978a7a; }
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 13rpx 0; color: #30271f; font-size: 27rpx; }
.info-row .label { color: #978a7a; }
.info-row .price { color: #a83e2a; font-weight: 700; }
.order-footer { padding-top: 18rpx; margin-top: 12rpx; border-top: 1rpx solid #eadcc7; text-align: right; }
.btn-cancel { display: inline-flex; height: 60rpx; padding: 0 30rpx; background: #fff9ef; border: 1rpx solid #b85b43; border-radius: 999rpx; color: #a83e2a; font-size: 24rpx; }
.empty, .login-tip { text-align: center; padding: 100rpx 0; color: #978a7a; }
.empty::before { content: "山水 · 暂无订单"; display: block; margin-bottom: 20rpx; color: #b99462; font-family: "STKaiti", "KaiTi", serif; font-size: 32rpx; }
.btn-login { width: 240rpx; height: 76rpx; margin: 26rpx auto 0; }
