.rooms-page { position:relative; padding-top:300rpx; }
.rooms-hero { position:absolute; top:0; left:-28rpx; width:calc(100% + 56rpx); height:300rpx; overflow:hidden; opacity:.52; pointer-events:none; }
.rooms-title { position:absolute; z-index:3; top:65rpx; left:0; right:0; text-align:center; color:#241f19; font-family:"STKaiti","KaiTi",serif; font-size:48rpx; font-weight:700; letter-spacing:4rpx; text-shadow:0 1rpx 8rpx rgba(255,249,239,.95); }
.rooms-seal { display:inline-flex; vertical-align:middle; align-items:center; justify-content:center; width:30rpx; height:42rpx; margin-left:8rpx; background:#a83e2a; border-radius:7rpx; color:#fff2df; font-family:"KaiTi",serif; font-size:17rpx; letter-spacing:0; writing-mode:vertical-rl; }
.filter-bar { position:relative; display:flex; align-items:center; padding:22rpx 34rpx; margin-bottom:24rpx; overflow:hidden; background:#fff9ef; border:2rpx solid #c8a46f; border-radius:24rpx; color:#655548; box-shadow:0 8rpx 20rpx rgba(91,63,35,.08); }
.filter-item { display:flex; flex:1; min-width:0; justify-content:center; }
.filter-item picker { width:100%; }
.picker-text { box-sizing:border-box; display:flex; align-items:center; justify-content:center; min-height:84rpx; padding:12rpx 8rpx; background:#fbf3e7; border:2rpx solid #f0dfc8; border-radius:999rpx; color:#30271f; font-size:23rpx; white-space:nowrap; }
.calendar-icon { margin-right:8rpx; color:#9d613b; font-size:28rpx; }
.filter-separator { width:52rpx; color:#655548; font-size:28rpx; text-align:center; }
.filter-corner { position:absolute; z-index:2; width:54rpx; height:54rpx; pointer-events:none; }
.corner-tl { top:0; left:0; }
.corner-tr { top:0; right:0; transform:scaleX(-1); }
.corner-bl { bottom:0; left:0; transform:scaleY(-1); }
.corner-br { bottom:0; right:0; transform:scale(-1); }
.preference-label { margin-right: 18rpx; color: #978a7a; }
.preference-item { display: flex; align-items: center; padding: 10rpx 18rpx; background: #f8f1e5; border: 1rpx solid #e9dcc9; border-radius: 12rpx; color: #655548; }
.preference-text { font-size: 26rpx; }
.preference-arrow { margin-left: 10rpx; color: #a83e2a; font-size: 20rpx; }
.section-title { display:flex; align-items:center; margin:24rpx 0 20rpx 6rpx; font-family:"STKaiti", "KaiTi", serif; font-size:38rpx; font-weight:700; color:#392c20; }
.section-title::before { content:""; display:block; width:8rpx; height:38rpx; margin-right:18rpx; background:#a83e2a; border-radius:8rpx; }
.section-cloud { width:180rpx; height:60rpx; margin-left:auto; opacity:.55; }
.room-card { padding:0; overflow:hidden; margin-bottom:26rpx; background:#fff9ef; border:2rpx solid #fffaf2; border-radius:22rpx; box-shadow:0 8rpx 22rpx rgba(91,63,35,.14); }
.room-image { display:block; width:100%; height:330rpx; background:#e9dcc9; border-radius:18rpx; }
.room-info { position:relative; padding:20rpx 26rpx 22rpx; }
.room-cloud { position:absolute; top:55rpx; right:0; width:140rpx; height:65rpx; opacity:.24; pointer-events:none; }
.room-name { position:relative; margin-bottom:14rpx; color:#30271f; font-size:32rpx; font-weight:700; overflow-wrap:anywhere; }
.room-tags { position:relative; display:flex; flex-wrap:wrap; gap:10rpx; margin-bottom:20rpx; }
.room-tags .tag { display:inline-flex; align-items:center; box-sizing:border-box; max-width:100%; padding:7rpx 14rpx; background:#f1e5d3; border-radius:999rpx; color:#655548; font-size:22rpx; line-height:1.4; overflow-wrap:anywhere; }
.tag-icon { flex:none; width:25rpx; height:25rpx; margin-right:8rpx; }
.room-bottom { position:relative; display:flex; justify-content:space-between; align-items:center; gap:16rpx; }
.price { min-width:0; display:flex; align-items:baseline; flex-wrap:wrap; }
.price .currency { color:#a83e2a; font-size:27rpx; font-weight:700; }
.price .amount { color:#a83e2a; font-size:42rpx; font-weight:700; line-height:1.2; overflow-wrap:anywhere; }
.price .unit { margin-left:4rpx; color:#655548; font-size:24rpx; white-space:nowrap; }
.btn-book { flex:none; display:flex; align-items:center; justify-content:center; min-width:150rpx; height:68rpx; margin:0; padding:0 24rpx; background:#a83e2a; border:0; border-radius:999rpx; color:#fff9ef; font-size:26rpx; line-height:normal; }
.book-arrow { margin-left:14rpx; font-size:36rpx; line-height:1; }
.loading, .empty { text-align: center; padding: 100rpx 0; color: #978a7a; }
.empty-icon, .empty-date-icon { display: block; margin-bottom: 22rpx; color: #b99462; font-size: 72rpx; }
.empty-text, .empty-date-text { display: block; margin-bottom: 14rpx; color: #655548; font-size: 30rpx; }
.empty-tip { color: #978a7a; font-size: 24rpx; }
.empty-date { display: flex; align-items: center; justify-content: center; min-height: 52vh; padding: 30rpx; }
.empty-date-content { display: flex; flex-direction: column; align-items: center; width: 100%; }
.date-picker-group { display: flex; flex-direction: column; width: 100%; max-width: 600rpx; }
.date-picker-btn { display: flex; flex-direction: column; align-items: center; padding: 26rpx; margin: 10rpx 0; background: #fff9ef; border: 1rpx solid #e4cfad; border-radius: 18rpx; }
.date-picker-label { color: #978a7a; font-size: 24rpx; }
.date-picker-value { color: #a83e2a; font-size: 30rpx; font-weight: 600; }

/* Reserve space for the custom four-item navigation bar. */
.container { padding-bottom: 150rpx; }
