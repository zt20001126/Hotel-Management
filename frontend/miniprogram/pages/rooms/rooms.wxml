<view class="container rooms-page">
  <image class="rooms-hero" src="/assets/images/chinese-style/banners/banner-plum-riverside.webp" mode="aspectFill" aria-hidden="true"></image>
  <view class="rooms-title">房型列表<text class="rooms-seal">民宿</text></view>
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  
  <!-- 房型列表 -->
  <view class="room-list" wx:if="{{!loading && roomTypes.length > 0}}">
    <view class="room-card card" wx:for="{{roomTypes}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="room-image" src="{{item.images[0] || 'https://dummyimage.com/400x300/667eea/ffffff.png&text=Room'}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}"></image>
      <view class="room-info">
        <image class="room-cloud" src="/images/cloud.svg" mode="aspectFit"></image>
        <view class="room-name">{{item.name}}</view>
        <view class="room-tags">
          <text class="tag">{{item.bedType}}</text>
          <text class="tag">{{item.area}}㎡</text>
          <text class="tag">最多{{item.maxGuests}}人</text>
        </view>
        <view class="room-bottom">
          <view class="price">
            <text class="amount">¥{{item.basePrice}}</text>
            <text class="unit">/晚</text>
          </view>
          <button class="btn-book" size="mini">预订</button>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && isEmpty}}">
    <text class="empty-icon">🏠</text>
    <text class="empty-text">暂无房型</text>
    <text class="empty-tip">当前暂无上架房型</text>
  </view>
</view>
