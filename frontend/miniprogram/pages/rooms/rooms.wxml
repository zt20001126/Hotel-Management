<view class="container rooms-page">
  <view class="rooms-hero" aria-hidden="true"><image class="rooms-plum" src="/images/plum-branch.svg" mode="aspectFit"></image><view class="rooms-sun"></view><view class="rooms-mountain rooms-mountain-back"></view><view class="rooms-mountain rooms-mountain-front"></view><image class="rooms-pavilion" src="/images/pavilion.svg" mode="aspectFit"></image></view>
  <view class="rooms-title">房型列表<text class="rooms-seal">民宿</text></view>
  <!-- 筛选栏 -->
  <view class="filter-bar card">
    <image class="filter-corner corner-tl" src="/images/keyfret.svg" mode="aspectFit"></image>
    <image class="filter-corner corner-tr" src="/images/keyfret.svg" mode="aspectFit"></image>
    <view class="filter-item">
      <picker mode="date" value="{{checkInDate}}" start="{{today}}" bindchange="onCheckInChange">
        <view class="picker-text"><text class="calendar-icon">▦</text><text>{{checkInDate || '入住日期'}}</text></view>
      </picker>
    </view>
    <text class="filter-separator">至</text>
    <view class="filter-item">
      <picker mode="date" value="{{checkOutDate}}" start="{{minCheckOut || today}}" bindchange="onCheckOutChange">
        <view class="picker-text"><text class="calendar-icon">▦</text><text>{{checkOutDate || '退房日期'}}</text></view>
      </picker>
    </view>
    <image class="filter-corner corner-bl" src="/images/keyfret.svg" mode="aspectFit"></image>
    <image class="filter-corner corner-br" src="/images/keyfret.svg" mode="aspectFit"></image>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>搜索中...</text>
  </view>
  
  <!-- 未选择日期时的提示 -->
  <view class="empty-date" wx:if="{{!loading && !checkInDate && !checkOutDate}}">
    <view class="empty-date-content">
      <text class="empty-date-icon">📅</text>
      <text class="empty-date-text">请在上方选择入住和退房日期</text>
    </view>
  </view>
  
  <!-- 房型列表 -->
  <view class="room-list" wx:if="{{!loading && roomTypes.length > 0}}">
    <view class="room-card card" wx:for="{{roomTypes}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="room-image" src="{{item.images[0] || 'https://dummyimage.com/400x300/667eea/ffffff.png&text=Room'}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}"></image>
      <view class="room-info">
        <image class="room-cloud" src="/images/cloud.svg" mode="aspectFit"></image>
        <view class="room-name">{{item.name}}</view>
        <view class="room-tags">
          <text class="tag">{{item.bedType}}</text>
          <text class="tag">{{item.area}}㎡</text>
          <text class="tag">最多{{item.maxGuests}}人</text>
        </view>
        <view class="room-bottom">
          <view class="price">
            <text class="amount">¥{{item.basePrice}}</text>
            <text class="unit">/晚</text>
          </view>
          <button class="btn-book" size="mini">预订</button>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && isEmpty && checkInDate && checkOutDate}}">
    <text class="empty-icon">🏠</text>
    <text class="empty-text">暂无可用房型</text>
    <text class="empty-tip">请尝试调整搜索条件</text>
  </view>
</view>
