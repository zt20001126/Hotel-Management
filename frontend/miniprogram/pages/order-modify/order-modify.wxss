page { background: #f8efe2; }
.modify-page { min-height: 100vh; box-sizing: border-box; background: linear-gradient(180deg, #faf2e7, #f8ead6); padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.top-art { position: relative; height: 90rpx; overflow: hidden; }
.plum-art { position: absolute; left: 0; top: -18rpx; width: 270rpx; height: 115rpx; }
.houses-art { position: absolute; right: 0; bottom: 0; width: 320rpx; height: 105rpx; opacity: .55; }
.content { padding: 0 32rpx 28rpx; }
.card { box-sizing: border-box; border: 1rpx solid #efe1cc; border-radius: 24rpx; background: #fcf7ef; box-shadow: 0 7rpx 20rpx rgba(112, 76, 36, .11); }
.room-info { display: flex; align-items: center; gap: 18rpx; padding: 20rpx; }
.room-image { flex: none; width: 155rpx; height: 120rpx; border-radius: 14rpx; background: #f0e5d5; }
.room-placeholder { display: flex; align-items: center; justify-content: center; }
.room-placeholder image { width: 52rpx; height: 52rpx; }
.room-main { flex: 1; min-width: 0; }
.room-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 10rpx; }
.room-name { min-width: 0; font-size: 28rpx; font-weight: 700; color: #25170f; overflow-wrap: anywhere; }
.room-price { flex: none; color: #ad2b1b; font-size: 27rpx; font-weight: 700; }
.per-night { font-size: 21rpx; }
.room-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 15rpx; }
.tag { display: flex; align-items: center; padding: 6rpx 10rpx; border-radius: 999rpx; background: #f2e6d5; color: #30251c; font-size: 19rpx; }
.tag image { width: 23rpx; height: 23rpx; margin-right: 5rpx; }
.form-card, .price-card { margin-top: 16rpx; padding: 25rpx 24rpx; }
.section-title { padding-left: 16rpx; border-left: 7rpx solid #b52d1b; color: #26170f; font-size: 31rpx; font-weight: 700; line-height: 36rpx; margin-bottom: 20rpx; }
.form-item, .price-row { display: flex; align-items: center; min-width: 0; }
.form-item { margin-top: 18rpx; }
.row-icon { flex: none; width: 34rpx; height: 34rpx; margin: 0 16rpx 0 8rpx; }
.label { flex: none; color: #26211d; font-size: 26rpx; }
.form-item picker { flex: 1; min-width: 0; margin-left: 25rpx; }
.picker-value { box-sizing: border-box; height: 64rpx; padding: 0 26rpx; border-radius: 999rpx; background: #f0ede8; display: flex; align-items: center; justify-content: space-between; font-size: 27rpx; font-weight: 600; }
.chevron { flex: none; width: 14rpx; height: 14rpx; border-top: 2rpx solid #947b5d; border-right: 2rpx solid #947b5d; transform: rotate(45deg); margin-left: 10rpx; }
.nights { display: flex; align-items: center; justify-content: center; margin-top: 22rpx; height: 58rpx; border-radius: 12rpx; background: #f8e7df; color: #ac2c1b; font-size: 27rpx; font-weight: 700; }
.nights image { width: 30rpx; height: 30rpx; margin-right: 15rpx; }
.price-row { min-height: 65rpx; border-bottom: 1rpx solid #eee4d7; }
.price-value { flex: 1; min-width: 0; text-align: right; margin-left: 12rpx; font-size: 27rpx; overflow-wrap: anywhere; }
.new-price { color: #ad2b1b; font-weight: 700; }
.refund { color: #537346; }
.price-row.diff { margin-top: 4rpx; padding-top: 8rpx; border-top: 2rpx dashed #e5d5c3; border-bottom: 0; }
.price-row.diff .label, .price-row.diff .price-value { font-weight: 700; }
.tip-card { position: relative; overflow: hidden; margin-top: 16rpx; padding: 26rpx 30rpx; background: #fdf3e3; border-color: #efce98; }
.tip-heading, .tip-content { position: relative; z-index: 1; }
.tip-heading { display: flex; align-items: center; color: #cc7909; font-size: 28rpx; font-weight: 700; margin-bottom: 12rpx; }
.tip-heading image { width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.tip-content { color: #514b46; font-size: 23rpx; line-height: 1.8; }
.bridge-art { position: absolute; right: 0; bottom: -8rpx; width: 245rpx; height: 90rpx; opacity: .22; }
.bottom-bar { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; padding: 24rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fcf8f2; box-shadow: 0 -4rpx 18rpx rgba(115, 83, 47, .06); }
.btn-submit { width: 100%; height: 82rpx; border-radius: 999rpx; background: linear-gradient(180deg, #b93220, #9e2416); font-size: 31rpx; }
.btn-submit[disabled] { opacity: .7; color: #fff9ef; background: #a83e2a; }
.button-arrow { margin-left: 16rpx; font-size: 45rpx; line-height: 1; }
