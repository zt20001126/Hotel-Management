page { min-height: 100%; background: #f8efe2; color: #30271f; }
.container { position: relative; box-sizing: border-box; min-height: 100vh; padding: 0 34rpx calc(150rpx + env(safe-area-inset-bottom)); overflow: hidden; background: linear-gradient(180deg, #fbf4e9 0%, #f8efe2 65%, #f5e8d6 100%); }
.top-decoration { position: relative; height: 128rpx; margin: 0 -34rpx 12rpx; overflow: hidden; }
.plum { position: absolute; top: 4rpx; left: -10rpx; width: 300rpx; height: 120rpx; }
.waterside { position: absolute; right: 0; bottom: 0; width: 380rpx; height: 110rpx; opacity: .42; }
.status-card { position: relative; z-index: 1; display: flex; align-items: center; box-sizing: border-box; min-height: 136rpx; padding: 25rpx 32rpx; border-radius: 34rpx; color: #71380e; background: linear-gradient(110deg, #fbe9c9 0%, #f8d69e 100%); box-shadow: 0 10rpx 24rpx rgba(155,104,38,.14); }
.status-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin-right: 24rpx; border-radius: 50%; background: #ce8c39; }
.status-icon image { width: 54rpx; height: 54rpx; }
.status-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.status-text { font-size: 40rpx; line-height: 1.25; font-weight: 700; }
.status-hint { margin-top: 8rpx; font-size: 26rpx; line-height: 1.5; }
.status-card.confirmed { color: #46633d; background: linear-gradient(110deg, #edf3df 0%, #dce9cb 100%); }
.status-card.confirmed .status-icon { background: #72945b; }
.status-card.checked_in { color: #46633d; background: linear-gradient(110deg, #edf3df 0%, #dce9cb 100%); }
.status-card.checked_in .status-icon { background: #72945b; }
.status-card.checked_out { color: #625c50; background: linear-gradient(110deg, #f1eee6 0%, #e6dfd1 100%); }
.status-card.checked_out .status-icon { background: #94866c; }
.status-card.cancelled { color: #8a382c; background: linear-gradient(110deg, #fae9e2 0%, #f3d5ca 100%); }
.status-card.cancelled .status-icon { background: #bb6754; }
.info-card.card { position: relative; z-index: 1; box-sizing: border-box; margin-top: 22rpx; padding: 24rpx 26rpx 22rpx; border: 0; border-radius: 30rpx; background: rgba(255, 250, 243, .96); box-shadow: 0 8rpx 22rpx rgba(125,87,39,.12); }
.section-title { margin: 0 0 14rpx; padding-left: 18rpx; border-left: 8rpx solid #b52d1b; color: #171512; font-size: 34rpx; line-height: 1.25; font-weight: 700; }
.info-row { display: flex; align-items: center; box-sizing: border-box; min-height: 62rpx; padding: 10rpx 0; border-bottom: 1rpx solid #eee3d6; color: #1c1a18; font-size: 28rpx; line-height: 1.4; }
.info-row:last-child { border-bottom: 0; }
.row-icon { flex: none; width: 38rpx; height: 38rpx; margin: 0 20rpx 0 6rpx; }
.info-row .label { flex: none; color: #30271f; }
.info-row .value { flex: 1; min-width: 0; margin-left: 14rpx; text-align: right; overflow-wrap: anywhere; word-break: break-all; }
.info-row .price { color: #bd321f; font-size: 34rpx; font-weight: 700; }
.info-row .text-success { color: #3d7035; font-weight: 700; }
.unpaid-row { min-height: 70rpx; margin: 10rpx -10rpx 0; padding: 10rpx; border: 0; border-radius: 20rpx; background: #fae4df; }
.unpaid-row .label, .unpaid-row .value { color: #b52d1b; font-weight: 700; }
.bottom-landscape { position: absolute; right: 0; bottom: 0; left: 0; height: 150rpx; background: url('/images/profile-landscape.png') center bottom / cover no-repeat; opacity: .22; pointer-events: none; }
.bottom-bar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; box-sizing: border-box; padding: 20rpx 34rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255, 250, 243, .97); box-shadow: 0 -4rpx 18rpx rgba(115,83,47,.08); }
.btn-cancel { width: 100%; height: 88rpx; padding: 0 24rpx; border: 2rpx solid #a83e2a; border-radius: 999rpx; color: #a83e2a; background: transparent; font-size: 32rpx; line-height: 84rpx; font-weight: 600; }
.btn-cancel:active { color: #8e3022; background: rgba(168,62,42,.06); }
.payment-item { box-sizing: border-box; margin-bottom: 16rpx; padding: 20rpx 22rpx; border-radius: 22rpx; background: #f7f7ef; }
.payment-item:last-child { margin-bottom: 0; }
.payment-row { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; min-width: 0; }
.payment-header { margin-bottom: 12rpx; }
.payment-type { flex: 1; min-width: 0; color: #30271f; font-size: 28rpx; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }
.payment-amount { flex: none; color: #a83e2a; font-size: 29rpx; line-height: 1.4; font-weight: 700; white-space: nowrap; }
.payment-info { margin-bottom: 8rpx; color: #827567; font-size: 24rpx; line-height: 1.5; }
.payment-no { flex: 1; min-width: 0; overflow-wrap: anywhere; word-break: break-all; }
.payment-time { color: #a69d92; font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }
.status-badge { display: inline-flex; flex: none; align-items: center; justify-content: center; padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 23rpx; line-height: 1.35; white-space: nowrap; }
.status-badge.success { color: #55715b; background: #e9f0e3; }
