<view class="profile-edit-page">
  <view class="top-art" aria-hidden="true">
    <image class="plum-art" src="/assets/images/chinese-style/decorations/decoration-plum-branch.webp" mode="aspectFit" />
    <image class="houses-art" src="/assets/images/chinese-style/decorations/decoration-baijianlou-houses.webp" mode="aspectFit" />
  </view>
  <view class="content">
    <view class="form-card card">
      <view class="section-title">个人信息</view>
      <view class="nickname-row" bindtap="editNickname">
        <image class="user-icon" src="/pages/booking/icon-user.svg" mode="aspectFit" />
        <text class="label">昵称</text>
        <input class="nickname-input" placeholder="请输入昵称" placeholder-class="placeholder" value="{{nickname}}" focus="{{nicknameFocused}}" bindinput="onNicknameInput" bindblur="onNicknameBlur" confirm-type="done" />
        <view class="chevron"></view>
      </view>
    </view>
  </view>
  <view class="landscape" aria-hidden="true">
    <image class="landscape-houses" src="/assets/images/chinese-style/decorations/decoration-baijianlou-houses.webp" mode="aspectFit" />
    <image class="landscape-bridge" src="/assets/images/chinese-style/decorations/decoration-stone-bridge-water.webp" mode="aspectFit" />
  </view>
  <view class="bottom-bar">
    <button class="btn-save btn-primary" bindtap="save" loading="{{loading}}" disabled="{{loading || !loaded}}">保存</button>
  </view>
</view>
