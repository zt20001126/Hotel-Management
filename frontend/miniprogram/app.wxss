page {
  min-height: 100%;
  background: #f8f1e5;
  background-image: url("/assets/images/chinese-style/backgrounds/background-paper-texture.webp");
  background-size: 100% 100vh;
  background-repeat: repeat-y;
  color: #30271f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button { display: flex; align-items: center; justify-content: center; text-align: center; }
button::after { border: 0; }
.container { min-height: 100vh; padding: 24rpx 28rpx 40rpx; box-sizing: border-box; }
.container::after { content:""; position:fixed; z-index:0; left:0; right:0; bottom:0; height:30rpx; background:url("/images/waves.svg") repeat-x bottom center / 250rpx 40rpx; pointer-events:none; opacity:.52; }
.card { background: #fff9ef; border: 1rpx solid #e4cfad; border-radius: 24rpx; box-shadow: 0 8rpx 24rpx rgba(91, 63, 35, .08); }
.btn-primary { color: #fff9ef; background: #a83e2a; border: 0; border-radius: 999rpx; font-size: 30rpx; font-weight: 600; }
.btn-primary:active, .btn-book:active { background: #8e3022; opacity: .92; }
.text-primary { color: #a83e2a; }
.text-success { color: #55715b; }
.text-warning { color: #b99462; }
.text-danger { color: #a83e2a; }
.text-gray { color: #978a7a; }
.text-bold { font-weight: 600; }
.flex { display: flex; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }

